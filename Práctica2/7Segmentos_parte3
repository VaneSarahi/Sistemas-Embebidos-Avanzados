#include <MKL25Z4.H>

#define DECODE    9
#define INTENSITY 10
#define SCANLIMIT 11
#define SHUTDOWN  12
#define TEST      15

typedef enum {
    STATE_READY,
    STATE_RUNNING,
    STATE_FINISHED
} TimerState;

TimerState current_state = STATE_READY;

int config_mm = 0;
int config_ss = 0;
int curr_mm = 0;
int curr_ss = 0;

int key_digits[4] = {0, 0, 0, 0};
int key_count = 0;

volatile uint32_t ms_ticks = 0;
uint32_t last_second_tick = 0;

void SysTick_Init(void);
void SPI0_init(void);
void max7219_write(unsigned char command, unsigned char data);
void display_time(int mm, int ss);
void rgb_init(void);
void set_rgb_state(TimerState state);
void buttons_init(void);
int check_button1_press(void);
int check_button2_press(void);
void keypad_init(void);
char keypad_scan(void);


void SysTick_Handler(void) {
    ms_ticks++;
}

int main(void) {
    SysTick_Init();
    SPI0_init();
    rgb_init();
    buttons_init();
    keypad_init();

    max7219_write(DECODE, 0x0F);    /* Decodificación Code B en 4 dígitos */
    max7219_write(SCANLIMIT, 3);    /* Escanear dígitos 0 a 3 */
    max7219_write(INTENSITY, 4);    /* Brillo moderado */
    max7219_write(TEST, 0);         /* Modo normal */
    max7219_write(SHUTDOWN, 1);     /* Encender controlador */

    display_time(0, 0);

    while (1) {
        char key = keypad_scan();
        int btn1 = check_button1_press();
        int btn2 = check_button2_press();

        set_rgb_state(current_state);

        switch (current_state) {

            case STATE_READY:

                if (btn1 && (curr_mm > 0 || curr_ss > 0)) {
                    last_second_tick = ms_ticks;
                    current_state = STATE_RUNNING;
                }


                if (btn2) {
                    curr_mm = config_mm;
                    curr_ss = config_ss;
                    key_count = 0;
                    display_time(curr_mm, curr_ss);
                }


                if (key >= '0' && key <= '9') {
                    if (key_count < 4) {
                        key_digits[key_count++] = key - '0';


                        int disp_m = (key_count >= 1 ? key_digits[2] * 10 : 0) + (key_count >= 2 ? key_digits[3] : 0);
                        int disp_s = (key_count >= 3 ? key_digits[0] * 10 : 0) + (key_count >= 4 ? key_digits[1] : 0);
                        display_time(disp_s, disp_m);
                    }
                }
                else if (key == '#') {
                    if (key_count == 4) {
                        int candidate_ss = (key_digits[2] * 10) + key_digits[3];
                        int candidate_mm = (key_digits[0] * 10) + key_digits[1];
                        if (candidate_ss <= 59) {
                            config_mm = candidate_mm;
                            config_ss = candidate_ss;
                            curr_mm = config_mm;
                            curr_ss = config_ss;
                        }
                    }
                    key_count = 0;
                    display_time(curr_mm, curr_ss);
                }
                else if (key == '*') {

                    key_count = 0;
                    display_time(curr_mm, curr_ss);
                }
                break;

            case STATE_RUNNING:
                if (btn1) {
                    current_state = STATE_READY;
                }

                if (ms_ticks - last_second_tick >= 1000) {
                    last_second_tick = ms_ticks;

                    if (curr_ss > 0) {
                        curr_ss--;
                    } else if (curr_mm > 0) {
                        curr_mm--;
                        curr_ss = 59;
                    }

                    display_time(curr_mm, curr_ss);

                    /* Fin del conteo */
                    if (curr_mm == 0 && curr_ss == 0) {
                        current_state = STATE_FINISHED;
                    }
                }
                break;

            case STATE_FINISHED:
                display_time(0, 0);

                if (btn2) {
                    curr_mm = config_mm;
                    curr_ss = config_ss;
                    key_count = 0;
                    current_state = STATE_READY;
                    display_time(curr_mm, curr_ss);
                }

                if (key >= '0' && key <= '9') {
                    key_digits[0] = key - '0';
                    key_count = 1;
                    current_state = STATE_READY;
                    display_time(key_digits[0] * 10, 0);
                }
                break;
        }
    }
}


void display_time(int mm, int ss) {
    int m_dec = (mm / 10) % 10;
    int m_uni = mm % 10;
    int s_dec = (ss / 10) % 10;
    int s_uni = ss % 10;

    max7219_write(1, m_dec);
    max7219_write(2, m_uni | 0x80);
    max7219_write(3, s_dec);
    max7219_write(4, s_uni);
}

void SPI0_init(void) {
    SIM->SCGC5 |= SIM_SCGC5_PORTC_MASK;
    SIM->SCGC4 |= SIM_SCGC4_SPI0_MASK;

    PORTC->PCR[5] = PORT_PCR_MUX(2);
    PORTC->PCR[6] = PORT_PCR_MUX(2);

    PORTC->PCR[4] = PORT_PCR_MUX(1);
    PTC->PDDR |= (1 << 4);
    PTC->PSOR = (1 << 4);

    SPI0->C1 = 0x10;
    SPI0->BR = 0x60;
    SPI0->C1 |= 0x40;
}

void max7219_write(unsigned char command, unsigned char data) {
    PTC->PCOR = (1 << 4);

    while (!(SPI0->S & 0x20)) {}
    SPI0->D = command;
    while (!(SPI0->S & 0x80)) {}
    (void)SPI0->D;

    while (!(SPI0->S & 0x20)) {}
    SPI0->D = data;
    while (!(SPI0->S & 0x80)) {}
    (void)SPI0->D;

    PTC->PSOR = (1 << 4);
}



void SysTick_Init(void) {
    /* 20.97152 MHz / 1000 = 1 ms */
    SysTick->LOAD = (20971520u / 1000u) - 1;
    SysTick->VAL  = 0;
    SysTick->CTRL = SysTick_CTRL_CLKSOURCE_Msk |
                    SysTick_CTRL_TICKINT_Msk   |
                    SysTick_CTRL_ENABLE_Msk;
}



void rgb_init(void) {
    SIM->SCGC5 |= SIM_SCGC5_PORTB_MASK | SIM_SCGC5_PORTD_MASK;

    PORTB->PCR[18] = PORT_PCR_MUX(1); /* Rojo */
    PORTB->PCR[19] = PORT_PCR_MUX(1); /* Verde */
    PORTD->PCR[1]  = PORT_PCR_MUX(1); /* Azul */

    PTB->PDDR |= (1 << 18) | (1 << 19);
    PTD->PDDR |= (1 << 1);

    PTB->PSOR = (1 << 18) | (1 << 19);
    PTD->PSOR = (1 << 1);
}

void set_rgb_state(TimerState state) {

    PTB->PSOR = (1 << 18) | (1 << 19);
    PTD->PSOR = (1 << 1);

    switch (state) {
        case STATE_READY:
            PTD->PCOR = (1 << 1);   /* Azul encendido */
            break;
        case STATE_RUNNING:
            PTB->PCOR = (1 << 19);  /* Verde encendido */
            break;
        case STATE_FINISHED:
            PTB->PCOR = (1 << 18);  /* Rojo encendido */
            break;
    }
}


void buttons_init(void) {
    SIM->SCGC5 |= SIM_SCGC5_PORTA_MASK;

    PORTA->PCR[1] = PORT_PCR_MUX(1) | PORT_PCR_PE_MASK | PORT_PCR_PS_MASK;
    PORTA->PCR[2] = PORT_PCR_MUX(1) | PORT_PCR_PE_MASK | PORT_PCR_PS_MASK;

    PTA->PDDR &= ~((1 << 1) | (1 << 2));
}

int check_button1_press(void) {
    static uint8_t last_btn1 = 1;
    uint8_t current = (PTA->PDIR & (1 << 1)) ? 1 : 0;
    int pressed = 0;

    if (last_btn1 == 1 && current == 0) {
        pressed = 1;
    }
    last_btn1 = current;
    return pressed;
}

int check_button2_press(void) {
    static uint8_t last_btn2 = 1;
    uint8_t current = (PTA->PDIR & (1 << 2)) ? 1 : 0;
    int pressed = 0;

    if (last_btn2 == 1 && current == 0) {
        pressed = 1;
    }
    last_btn2 = current;
    return pressed;
}


void keypad_init(void) {
    SIM->SCGC5 |= SIM_SCGC5_PORTC_MASK | SIM_SCGC5_PORTD_MASK;

    PORTD->PCR[0] = PORT_PCR_MUX(1);
    PORTD->PCR[2] = PORT_PCR_MUX(1);
    PORTD->PCR[3] = PORT_PCR_MUX(1);
    PORTD->PCR[4] = PORT_PCR_MUX(1);
    PTD->PDDR |= (1 << 0) | (1 << 2) | (1 << 3) | (1 << 4);
    PTD->PSOR = (1 << 0) | (1 << 2) | (1 << 3) | (1 << 4);

    PORTC->PCR[7]  = PORT_PCR_MUX(1) | PORT_PCR_PE_MASK | PORT_PCR_PS_MASK;
    PORTC->PCR[8]  = PORT_PCR_MUX(1) | PORT_PCR_PE_MASK | PORT_PCR_PS_MASK;
    PORTC->PCR[9]  = PORT_PCR_MUX(1) | PORT_PCR_PE_MASK | PORT_PCR_PS_MASK;
    PORTC->PCR[10] = PORT_PCR_MUX(1) | PORT_PCR_PE_MASK | PORT_PCR_PS_MASK;
    PTC->PDDR &= ~((1 << 7) | (1 << 8) | (1 << 9) | (1 << 10));
}

char keypad_scan(void) {
    const char keys[4][4] = {
        {'1', '2', '3', 'A'},
        {'4', '5', '6', 'B'},
        {'7', '8', '9', 'C'},
        {'*', '0', '#', 'D'}
    };
    const uint8_t row_pins[4] = {0, 2, 3, 4};
    static char last_key = 0;
    char current_detected = 0;

    for (int r = 0; r < 4; r++) {

        PTD->PSOR = (1 << 0) | (1 << 2) | (1 << 3) | (1 << 4);
        PTD->PCOR = (1 << row_pins[r]);


        for (volatile int d = 0; d < 50; d++) {}

        uint32_t col_in = PTC->PDIR;
        if (!(col_in & (1 << 7)))  current_detected = keys[r][0];
        if (!(col_in & (1 << 8)))  current_detected = keys[r][1];
        if (!(col_in & (1 << 9)))  current_detected = keys[r][2];
        if (!(col_in & (1 << 10))) current_detected = keys[r][3];

        if (current_detected != 0) break;
    }

    PTD->PSOR = (1 << 0) | (1 << 2) | (1 << 3) | (1 << 4);

    char return_key = 0;
    if (current_detected != 0 && last_key == 0) {
        return_key = current_detected;
    }
    last_key = current_detected;

    return return_key;
}
