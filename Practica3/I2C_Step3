 /*  CONEXIONES
 *  LCD 16x2 (4 bits): RS=PTA1, EN=PTA2, D4..D7=PTC0..PTC3, RW=GND
 *  DS3231 (I2C0):     SCL=PTC8, SDA=PTC9  (dirección 0x68)
 *  MAX7219 (SPI0):    DIN=PTD2, CLK=PTD1, LOAD/CS=PTD0
 *  Keypad 4x4:        Filas    R1..R4 = PTB0..PTB3   (salidas)
 *                     Columnas C1..C4 = PTB8..PTB11  (entradas con pull-up)
 *
 *  MAPA DEL TECLADO
 *  #  -> Entrar a Configuración (SET TIME -> SET DATE)
 *  0-9-> Dígitos
 *  B  -> Borrar último dígito
 *  #  -> Confirmar
 *  C  -> Cancelar y regresar a Normal sin guardar
 */

#define LCD_RS_PIN      1
#define LCD_EN_PIN      2
#define LCD_D4_PIN      0
#define LCD_D5_PIN      1
#define LCD_D6_PIN      2
#define LCD_D7_PIN      3

#define DS3231_I2C_ADDR    0x68
#define I2C_TIMEOUT        100000U

#define DS3231_REG_CONTROL 0x0E
#define DS3231_REG_STATUS  0x0F

// MAX7219 
#define MAX_CS_PIN         0      /* PTD0 */
#define MAX_REG_DIGIT0     0x01
#define MAX_REG_DECODE     0x09
#define MAX_REG_INTENSITY  0x0A
#define MAX_REG_SCANLIMIT  0x0B
#define MAX_REG_SHUTDOWN   0x0C
#define MAX_REG_TEST       0x0F
#define MAX_NUM_DIGITS     4
#define MAX_BLANK          0x0F
#define MAX_DP             0x80
#define MAX_REVERSE_DIGITS 0

// KEYPAD
#define KP_ROW0_PIN        0      // PTB0..PTB3  = filas    
#define KP_COL0_PIN        8      // PTB8..PTB11 = columnas

